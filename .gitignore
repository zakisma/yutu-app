# ============================================
# Yutu — bachelor thesis project gitignore
# ============================================

# --- Secrets ---
.env
backend/.env
yutu_frontend/.env
.env.*

# --- Go ---
# Compiled binary output (regenerated by `go build`)
backend/main
backend/api
backend/__debug_bin*
backend/*.exe

# --- Flutter ---
# Build cache and generated files
yutu_frontend/.dart_tool/
yutu_frontend/.flutter-plugins
yutu_frontend/.flutter-plugins-dependencies
yutu_frontend/.packages
yutu_frontend/build/
yutu_frontend/coverage/

# Platform-specific generated artifacts
yutu_frontend/ios/Pods/
yutu_frontend/ios/.symlinks/
yutu_frontend/ios/Flutter/Flutter.framework/
yutu_frontend/ios/Flutter/Flutter.podspec
yutu_frontend/android/.gradle/
yutu_frontend/android/local.properties
yutu_frontend/android/key.properties
yutu_frontend/android/app/release/

!nginx.conf

# --- IDE / Editor settings ---
.vscode/
.idea/
*.iml
*.swp
*.swo

# --- OS metadata ---
.DS_Store
Thumbs.db
desktop.ini

# --- Log files ---
*.log
backend/logs/

# --- Test output (optional, but keeps the repo clean) ---
backend/coverage.out
backend/*.test

